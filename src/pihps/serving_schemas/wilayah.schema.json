{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "serving/wilayah/<kode>.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tanggal_acuan": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "wilayah": {
      "type": "object",
      "properties": {
        "kode": {
          "type": "string",
          "pattern": "^(nasional|prov-\\d+|kab-\\d+)$"
        },
        "nama": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "nasional",
            "provinsi",
            "kabkota"
          ]
        },
        "kode_provinsi": {
          "type": [
            "string",
            "null"
          ]
        },
        "nama_provinsi": {
          "type": [
            "string",
            "null"
          ]
        },
        "kode_bps": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{2}(\\d{2})?$"
        }
      },
      "required": [
        "kode",
        "nama",
        "level",
        "kode_provinsi",
        "nama_provinsi",
        "kode_bps"
      ],
      "additionalProperties": false
    },
    "pasar": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jenis_pasar_id": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "terkini": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "komoditas_id": {
                  "type": "string",
                  "pattern": "^(cat|com)_\\d+$"
                },
                "tanggal": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "harga": {
                  "type": "integer",
                  "minimum": 1
                },
                "tanggal_sebelumnya": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "harga_sebelumnya": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "harga_7h": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "harga_30h": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "harga_1th": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "perubahan_pct_sebelumnya": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "perubahan_pct_7h": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "perubahan_pct_30h": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "perubahan_pct_1th": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "arah_7h": {
                  "enum": [
                    "naik",
                    "turun",
                    "tetap",
                    null
                  ]
                },
                "selisih_pct_nasional": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "is_aktif": {
                  "type": "boolean"
                }
              },
              "required": [
                "komoditas_id",
                "tanggal",
                "harga",
                "tanggal_sebelumnya",
                "harga_sebelumnya",
                "harga_7h",
                "harga_30h",
                "harga_1th",
                "perubahan_pct_sebelumnya",
                "perubahan_pct_7h",
                "perubahan_pct_30h",
                "perubahan_pct_1th",
                "arah_7h",
                "selisih_pct_nasional",
                "is_aktif"
              ],
              "additionalProperties": false
            }
          },
          "harian": {
            "type": "object",
            "properties": {
              "tanggal": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "harga": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(cat|com)_\\d+$"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "tanggal",
              "harga"
            ],
            "additionalProperties": false
          },
          "bulanan": {
            "type": "object",
            "properties": {
              "bulan": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}$"
                }
              },
              "harga": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(cat|com)_\\d+$"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "bulan",
              "harga"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "jenis_pasar_id",
          "terkini",
          "harian",
          "bulanan"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "tanggal_acuan",
    "wilayah",
    "pasar"
  ],
  "additionalProperties": false
}
