---
// Tampilan utama: harga terkini satu wilayah, per jenis pasar, + grafik per komoditas.
import WilayahPicker from "./WilayahPicker.astro";
import { getMeta, getWilayah, komoditasMap } from "../lib/data";
import { tanggalPanjang, tanggalPendek } from "../lib/format";
import { panelPasar, type RenderCtx } from "../lib/render";
import { BASE, dataUrl, href } from "../lib/url";
import type { JenisPasarId } from "../lib/types";

interface Props {
  kode: string;
}
const { kode } = Astro.props;
const meta = getMeta();
const doc = getWilayah(kode);
const w = doc.wilayah;
const isNasional = w.level === "nasional";
const ctx: RenderCtx = { base: BASE, komoditas: komoditasMap(meta), kategori: meta.kategori, isNasional };
const pasarNama = new Map(meta.jenis_pasar.map((p) => [p.id, p.nama]));
const urutan: JenisPasarId[] = [1, 2, 3, 4];
const pasarList = [...doc.pasar].sort((a, b) => urutan.indexOf(a.jenis_pasar_id) - urutan.indexOf(b.jenis_pasar_id));
const awal = pasarList.find((p) => p.jenis_pasar_id === 1) ?? pasarList[0];
const tanggalData = awal?.terkini.reduce((m, t) => (t.tanggal > m ? t.tanggal : m), "") || doc.tanggal_acuan;
const judul = isNasional ? "Harga pangan hari ini" : `Harga pangan di ${w.nama}`;
const kicker = isNasional ? "Rata-rata nasional" : w.level === "kabkota" ? `Kabupaten/kota · ${w.nama_provinsi ?? ""}` : "Provinsi";
const lokasi = isNasional ? "rata-rata nasional" : w.level === "kabkota" ? `${w.nama}, ${w.nama_provinsi}` : w.nama;
const komoditasGrafik = meta.komoditas.filter((k) => k.level === 2);
const komoditasAwal = komoditasGrafik.find((k) => awal?.harian.harga[k.id]?.some((v) => v != null))?.id ?? "com_1";
// Konteks kecil untuk render ulang di peramban (nama, satuan, kategori).
const clientCtx = {
  kode,
  isNasional,
  komoditas: meta.komoditas.map((k) => ({ id: k.id, nama: k.nama, satuan: k.satuan, level: k.level })),
  kategori: meta.kategori,
  pasar: Object.fromEntries(meta.jenis_pasar.map((p) => [p.id, p.nama])),
  url: dataUrl(`serving/wilayah/${kode}.json`),
};
---

<section class="hero">
  <p class="kicker">{kicker}</p>
  <h1>{judul}</h1>
  <p class="hero__ket">
    {isNasional ? "Harga rata-rata nasional" : `Harga rata-rata di ${lokasi}`} untuk {komoditasGrafik.length} bahan pangan pokok, data <time datetime={tanggalData}>{tanggalPanjang(tanggalData)}</time>.
    Ketuk satu baris untuk melihat tren dan harga di provinsi lain.
  </p>
</section>

<div class="kontrol kontrol--harga">
  <WilayahPicker wilayah={meta.wilayah} aktif={kode} />
</div>

{pasarList.length === 0 ? (
  <p class="kosong">Belum ada data harga untuk wilayah ini.</p>
) : (
  <section class="bagian bagian--papan" id="harga" data-ctx={JSON.stringify(clientCtx)}>
    <div class="tab" role="tablist" aria-label="Jenis pasar">
      {pasarList.map((p) => (
        <button type="button" role="tab" id={`tab-${p.jenis_pasar_id}`} aria-controls="panel-harga" aria-selected={p === awal ? "true" : "false"} data-pasar={p.jenis_pasar_id}>
          {pasarNama.get(p.jenis_pasar_id)}
        </button>
      ))}
    </div>
    <div id="panel-harga" role="tabpanel" aria-labelledby={`tab-${awal?.jenis_pasar_id}`} aria-live="polite">
      <Fragment set:html={awal ? panelPasar(awal, ctx).value : ""} />
    </div>
  </section>

  <section class="bagian panel" aria-labelledby="judul-grafik">
    <div class="bagian__kepala">
      <h2 id="judul-grafik">Grafik harga</h2>
      <p class="catatan" id="ket-grafik"></p>
    </div>
    <div class="kontrol">
      <div class="isian">
        <label for="grafik-komoditas">Komoditas</label>
        <select id="grafik-komoditas">
          {meta.kategori.map((kat) => (
            <optgroup label={kat.nama}>
              {kat.komoditas.map((id) => {
                const k = ctx.komoditas.get(id);
                return k ? <option value={id} selected={id === komoditasAwal}>{k.nama}</option> : null;
              })}
            </optgroup>
          ))}
        </select>
      </div>
      <div class="tab tab--kecil" role="tablist" aria-label="Rentang waktu">
        <button type="button" role="tab" aria-selected="true" data-rentang="harian">3 bulan</button>
        <button type="button" role="tab" aria-selected="false" data-rentang="bulanan">Semua, bulanan</button>
      </div>
    </div>
    <div id="grafik-wilayah" class="grafik grafik-memuat" role="img" aria-label="Grafik harga komoditas terpilih per jenis pasar">Memuat grafik…</div>
    <p class="catatan">
      Satu garis per jenis pasar. Nilai yang terdeteksi sebagai salah input di sumber tidak ditampilkan.{" "}
      <a href={href("tentang/#metode")}>Metode</a>
    </p>
  </section>
)}

<p class="catatan bagian">
  Harga adalah rata-rata harga pasar yang dipantau PIHPS Bank Indonesia di {isNasional ? "seluruh Indonesia" : lokasi}, bukan harga satu
  pedagang. Data diperbarui setiap hari kerja. Terakhir diproses {tanggalPendek(meta.dibuat_pada.slice(0, 10))}.
</p>

<script>
  import { panelPasar, type RenderCtx } from "../lib/render";
  import { bulanPendek, tanggalPendek } from "../lib/format";
  import type { Komoditas, Kategori, WilayahDoc } from "../lib/types";

  interface ClientCtx {
    kode: string;
    isNasional: boolean;
    komoditas: Pick<Komoditas, "id" | "nama" | "satuan" | "level">[];
    kategori: Kategori[];
    pasar: Record<string, string>;
    url: string;
  }

  const root = document.getElementById("harga");
  if (root?.dataset["ctx"]) {
    const c = JSON.parse(root.dataset["ctx"]) as ClientCtx;
    const ctx: RenderCtx = {
      base: import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`,
      komoditas: new Map(c.komoditas.map((k) => [k.id, k as Komoditas])),
      kategori: c.kategori,
      isNasional: c.isNasional,
    };
    let docPromise: Promise<WilayahDoc> | null = null;
    const loadDoc = () =>
      (docPromise ??= fetch(c.url).then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json() as Promise<WilayahDoc>;
      }));

    // --- tab jenis pasar
    const panel = document.getElementById("panel-harga")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-pasar]")];
    tabs.forEach((tab) =>
      tab.addEventListener("click", async () => {
        tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
        panel.setAttribute("aria-labelledby", tab.id);
        try {
          const doc = await loadDoc();
          const pasar = doc.pasar.find((p) => String(p.jenis_pasar_id) === tab.dataset["pasar"]);
          if (pasar) panel.innerHTML = panelPasar(pasar, ctx).value;
        } catch {
          panel.innerHTML = '<p class="kosong">Gagal memuat data. Periksa koneksi lalu coba lagi.</p>';
        }
      }),
    );

    // --- grafik (ECharts dimuat saat bagian grafik terlihat)
    const el = document.getElementById("grafik-wilayah")!;
    const pilih = document.getElementById("grafik-komoditas") as HTMLSelectElement;
    const ket = document.getElementById("ket-grafik")!;
    const rentangTabs = [...document.querySelectorAll<HTMLButtonElement>("[data-rentang]")];
    let rentang: "harian" | "bulanan" = "harian";

    async function gambar() {
      const [{ mount, baseOption, gayaGaris, rp, rpRingkas, warnaPasar, zoom }, doc] = await Promise.all([import("../lib/charts"), loadDoc()]);
      el.classList.remove("grafik-memuat");
      el.textContent = "";
      const chart = mount(el);
      const id = pilih.value;
      const k = ctx.komoditas.get(id);
      const series = doc.pasar.map((p) => {
        const s = p[rentang];
        const xs = rentang === "harian" ? (s as WilayahDoc["pasar"][number]["harian"]).tanggal : (s as WilayahDoc["pasar"][number]["bulanan"]).bulan;
        return {
          ...gayaGaris,
          name: c.pasar[String(p.jenis_pasar_id)] ?? String(p.jenis_pasar_id),
          color: warnaPasar(p.jenis_pasar_id),
          data: xs.map((x, i) => [x, s.harga[id]?.[i] ?? null]),
        };
      }).filter((s) => s.data.some((d) => d[1] != null));
      const base = baseOption();
      chart.setOption(
        {
          ...base,
          tooltip: { ...(base["tooltip"] as object), valueFormatter: rp },
          xAxis: {
            ...(base["xAxis"] as object),
            type: "category",
            boundaryGap: false,
            axisLabel: {
              ...((base["xAxis"] as { axisLabel: object }).axisLabel),
              formatter: (v: string) => (rentang === "harian" ? tanggalPendek(v).replace(/ \d{4}$/, "") : bulanPendek(v)),
            },
          },
          yAxis: { ...(base["yAxis"] as object), type: "value", scale: true, axisLabel: { formatter: rpRingkas } },
          dataZoom: rentang === "bulanan" ? zoom() : [],
          series,
        },
        { notMerge: true },
      );
      ket.textContent = series.length
        ? `${k?.nama ?? id}, ${rentang === "harian" ? "harga harian 3 bulan terakhir" : "rata-rata bulanan"}`
        : "Belum ada data untuk komoditas ini";
    }

    pilih.addEventListener("change", () => void gambar());
    rentangTabs.forEach((b) =>
      b.addEventListener("click", () => {
        rentang = b.dataset["rentang"] as typeof rentang;
        rentangTabs.forEach((t) => t.setAttribute("aria-selected", String(t === b)));
        void gambar();
      }),
    );
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        obs.disconnect();
        gambar().catch(() => (el.textContent = "Gagal memuat grafik."));
      }
    }, { rootMargin: "200px" }).observe(el);
  }
</script>
