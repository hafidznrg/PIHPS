---
// Tampilan utama satu wilayah. Hierarki fokus:
//   1. judul = satu insight terkuat minggu ini (+ hitungan naik/turun/stabil)
//   2. kartu sorotan (naik tertinggi, turun terdalam, beras, sorotan wilayah)
//   3. papan semua komoditas, lalu grafik tren dan catatan.
// Keempat jenis pasar dirender saat build sehingga ganti pasar instan tanpa unduhan.
import WilayahPicker from "./WilayahPicker.astro";
import { getMeta, getPeta, getWilayah, komoditasMap } from "../lib/data";
import { tanggalPanjang, tanggalPendek } from "../lib/format";
import { urutTimpang, type TimpangPeta } from "../lib/peta";
import { judulInsight, panelBeranda, type RenderCtx, type Timpang } from "../lib/render";
import { BASE, href } from "../lib/url";
import type { JenisPasarId } from "../lib/types";

interface Props {
  kode: string;
}
const { kode } = Astro.props;
const meta = getMeta();
const doc = getWilayah(kode);
const w = doc.wilayah;
const isNasional = w.level === "nasional";
const ctx: RenderCtx = { base: BASE, komoditas: komoditasMap(meta), kategori: meta.kategori, isNasional };
const pasarMeta = new Map(meta.jenis_pasar.map((p) => [p.id, p]));
const urutan: JenisPasarId[] = [1, 2, 3, 4];
const pasarList = [...doc.pasar].sort((a, b) => urutan.indexOf(a.jenis_pasar_id) - urutan.indexOf(b.jenis_pasar_id));
const awal = pasarList.find((p) => p.jenis_pasar_id === 1) ?? pasarList[0];
const tanggalData = awal?.terkini.reduce((m, t) => (t.tanggal > m ? t.tanggal : m), "") || doc.tanggal_acuan;
const lokasi = isNasional ? "Rata-rata nasional" : w.level === "kabkota" ? `${w.nama}, ${w.nama_provinsi ?? ""}` : w.nama;
const level2 = meta.komoditas.filter((k) => k.level === 2).map((k) => k.id);

function timpangUntuk(id: JenisPasarId): Timpang[] {
  const pm = pasarMeta.get(id);
  if (!isNasional || !pm) return [];
  let list: TimpangPeta[] = [];
  try {
    list = urutTimpang(getPeta(pm.slug), level2).slice(0, 4);
  } catch {
    return []; // file peta jenis pasar ini tidak ada: kartu timpang dilewati
  }
  return list.map((t) => ({
    komoditas_id: t.komoditas_id,
    murah: { nama: t.murah.nama, harga: t.murah.harga },
    mahal: { nama: t.mahal.nama, harga: t.mahal.harga },
    selisih: t.selisih,
    href: href(`peta/?k=${t.komoditas_id}&p=${pm.slug}`),
  }));
}
const panels = pasarList.map((p) => ({
  id: p.jenis_pasar_id,
  judul: judulInsight(p, ctx),
  html: panelBeranda(p, ctx, timpangUntuk(p.jenis_pasar_id)).value,
}));
const komoditasAwal = meta.komoditas.find((k) => k.level === 2 && awal?.harian.harga[k.id]?.some((v) => v != null))?.id ?? "com_1";
const grafikCtx = {
  url: href(`data/view/wilayah/${kode}/`),
  pasar: Object.fromEntries(meta.jenis_pasar.map((p) => [p.id, p.nama])),
  komoditas: Object.fromEntries(meta.komoditas.map((k) => [k.id, k.nama])),
};
---

<div class="saring saring--atas" role="group" aria-label="Pilih wilayah dan jenis pasar">
  <WilayahPicker wilayah={meta.wilayah} aktif={kode} />
  {pasarList.length > 1 && (
    <label class="saring__isian">
      <span class="sr-only">Jenis pasar</span>
      <select id="pilih-pasar">
        {pasarList.map((p) => <option value={String(p.jenis_pasar_id)} selected={p === awal}>{pasarMeta.get(p.jenis_pasar_id)?.nama}</option>)}
      </select>
    </label>
  )}
</div>

<section class="hero hero--insight">
  <p class="kicker">{lokasi} · <time datetime={tanggalData}>{tanggalPanjang(tanggalData)}</time></p>
  <h1 id="judul-insight">{panels[0]?.judul ?? `Harga pangan di ${w.nama}`}</h1>
</section>

{pasarList.length === 0 ? (
  <p class="kosong">Belum ada data harga untuk wilayah ini.</p>
) : (
  <div id="harga" aria-live="polite">
    {panels.map((p, i) => (
      <div class="panel-pasar" data-pasar={p.id} data-judul={p.judul} hidden={i !== 0}>
        <Fragment set:html={p.html} />
      </div>
    ))}
  </div>
)}

{pasarList.length > 0 && (
  <section class="bagian panel" aria-labelledby="judul-grafik" id="bagian-grafik" data-ctx={JSON.stringify(grafikCtx)}>
    <div class="bagian__kepala">
      <h2 id="judul-grafik">Tren harga</h2>
      <p class="catatan" id="ket-grafik"></p>
    </div>
    <div class="saring">
      <label class="saring__isian saring__isian--lebar">
        <span class="sr-only">Komoditas</span>
        <select id="grafik-komoditas">
          {meta.kategori.map((kat) => (
            <optgroup label={kat.nama}>
              {kat.komoditas.map((id) => {
                const k = ctx.komoditas.get(id);
                return k ? <option value={id} selected={id === komoditasAwal}>{k.nama}</option> : null;
              })}
            </optgroup>
          ))}
        </select>
      </label>
      <div class="tab tab--kecil" role="tablist" aria-label="Rentang waktu">
        <button type="button" role="tab" aria-selected="true" data-rentang="harian">3 bulan</button>
        <button type="button" role="tab" aria-selected="false" data-rentang="bulanan">Semua, bulanan</button>
      </div>
    </div>
    <div id="grafik-wilayah" class="grafik grafik-memuat" role="img" aria-label="Grafik harga komoditas terpilih per jenis pasar">Memuat grafik…</div>
    <p class="catatan">Satu garis per jenis pasar. Nilai yang terdeteksi salah input di sumber tidak ditampilkan.</p>
  </section>
)}

<p class="catatan bagian">
  Rata-rata harga pasar yang dipantau PIHPS Bank Indonesia, bukan harga satu pedagang. Diperbarui setiap hari kerja; terakhir
  diproses {tanggalPendek(meta.dibuat_pada.slice(0, 10))}. <a href={href("tentang/#metode")}>Metode</a>
</p>

<script>
  import { bulanPendek, tanggalPendek } from "../lib/format";

  interface View {
    pasar: { id: number; x: string[]; harga: Record<string, (number | null)[]> }[];
  }
  interface GrafikCtx {
    url: string;
    pasar: Record<string, string>;
    komoditas: Record<string, string>;
  }

  // --- jenis pasar: semua panel sudah ada di HTML; cukup tukar yang tampil
  const pilihPasar = document.getElementById("pilih-pasar") as HTMLSelectElement | null;
  const judul = document.getElementById("judul-insight");
  const panels = [...document.querySelectorAll<HTMLElement>(".panel-pasar")];
  pilihPasar?.addEventListener("change", () => {
    for (const p of panels) {
      const aktif = p.dataset["pasar"] === pilihPasar.value;
      p.hidden = !aktif;
      if (aktif && judul) judul.textContent = p.dataset["judul"] ?? "";
    }
  });

  // --- grafik (ECharts & data dimuat hanya saat bagian grafik hampir terlihat)
  const bagian = document.getElementById("bagian-grafik");
  if (bagian?.dataset["ctx"]) {
    const c = JSON.parse(bagian.dataset["ctx"]) as GrafikCtx;
    const el = document.getElementById("grafik-wilayah")!;
    const pilih = document.getElementById("grafik-komoditas") as HTMLSelectElement;
    const ket = document.getElementById("ket-grafik")!;
    const rentangTabs = [...bagian.querySelectorAll<HTMLButtonElement>("[data-rentang]")];
    let rentang: "harian" | "bulanan" = "harian";
    const views = new Map<string, Promise<View>>();
    const loadView = (r: string) => {
      if (!views.has(r))
        views.set(
          r,
          fetch(`${c.url}${r}.json`).then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json() as Promise<View>;
          }),
        );
      return views.get(r)!;
    };

    async function gambar() {
      const [{ mount, baseOption, gayaGaris, rp, rpRingkas, warnaPasar, zoom }, view] = await Promise.all([import("../lib/charts"), loadView(rentang)]);
      el.classList.remove("grafik-memuat");
      el.textContent = "";
      const chart = mount(el);
      const id = pilih.value;
      const series = view.pasar
        .map((p) => ({
          ...gayaGaris,
          name: c.pasar[String(p.id)] ?? String(p.id),
          color: warnaPasar(p.id),
          data: p.x.map((x, i) => [x, p.harga[id]?.[i] ?? null]),
        }))
        .filter((s) => s.data.some((d) => d[1] != null));
      const base = baseOption();
      chart.setOption(
        {
          ...base,
          tooltip: { ...(base["tooltip"] as object), valueFormatter: rp },
          xAxis: {
            ...(base["xAxis"] as object),
            type: "category",
            boundaryGap: false,
            axisLabel: {
              ...((base["xAxis"] as { axisLabel: object }).axisLabel),
              formatter: (v: string) => (rentang === "harian" ? tanggalPendek(v).replace(/ \d{4}$/, "") : bulanPendek(v)),
            },
          },
          yAxis: { ...(base["yAxis"] as object), type: "value", scale: true, axisLabel: { formatter: rpRingkas } },
          dataZoom: rentang === "bulanan" ? zoom() : [],
          series,
        },
        { notMerge: true },
      );
      ket.textContent = series.length
        ? `${c.komoditas[id] ?? id}, ${rentang === "harian" ? "harian 3 bulan terakhir" : "rata-rata bulanan"}`
        : "Belum ada data untuk komoditas ini";
    }
    const coba = () => gambar().catch(() => (el.textContent = "Gagal memuat grafik."));

    pilih.addEventListener("change", () => void coba());
    rentangTabs.forEach((b) =>
      b.addEventListener("click", () => {
        rentang = b.dataset["rentang"] as typeof rentang;
        rentangTabs.forEach((t) => t.setAttribute("aria-selected", String(t === b)));
        void coba();
      }),
    );
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) {
          obs.disconnect();
          void coba();
        }
      },
      { rootMargin: "300px" },
    ).observe(el);
  }
</script>
