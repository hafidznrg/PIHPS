---
// Peta harga per provinsi. Peta = SVG yang dibangun saat build (lib/geo.ts) dan diwarnai
// relatif terhadap rata-rata nasional; tampil tanpa JavaScript. JS kecil hanya untuk ganti
// komoditas/pasar (fetch peta/<pasar>.json), tooltip, dan sorotan peta <-> tabel.
import Base from "../layouts/Base.astro";
import { getMeta, getPeta, komoditasMap } from "../lib/data";
import { satuan, tanggalPendek } from "../lib/format";
import { petaSvg } from "../lib/geo";
import { kelasPerProvinsi, legendaPeta, ringkas, ringkasPeta, sorotanPeta, tabelPeta } from "../lib/peta";
import { BASE, dataUrl } from "../lib/url";

const meta = getMeta();
const kmap = komoditasMap(meta);
const awalK = kmap.has("com_3") ? "com_3" : (meta.komoditas.find((k) => k.level === 2)?.id ?? "com_1");
const awalP = meta.jenis_pasar[0]!;
const rows = getPeta(awalP.slug).komoditas[awalK] ?? [];
const sat = satuan(kmap.get(awalK)?.satuan);
const svg = petaSvg();
const kelas = kelasPerProvinsi(rows);
const r = ringkas(rows);
const pos = (kode: string | null | undefined) => {
  const p = svg.provinsi.find((x) => x.kode_bps === kode);
  return p ? { x: (p.cx / svg.w) * 100, y: (p.cy / svg.h) * 100 } : null;
};
const penanda = r
  ? [
      { id: "mahal", label: "Termahal", nama: r.termahal.nama, p: pos(r.termahal.kode_bps) },
      { id: "murah", label: "Termurah", nama: r.termurah.nama, p: pos(r.termurah.kode_bps) },
    ]
  : [];
const clientCtx = {
  pasar: meta.jenis_pasar.map((p) => p.slug),
  komoditas: Object.fromEntries(meta.komoditas.map((k) => [k.id, { nama: k.nama, satuan: k.satuan }])),
  pusat: Object.fromEntries(svg.provinsi.map((p) => [p.kode_bps, [+((p.cx / svg.w) * 100).toFixed(2), +((p.cy / svg.h) * 100).toFixed(2)]])),
  dataBase: dataUrl("serving/peta/"),
  base: BASE,
};
---

<Base
  title="Peta harga pangan per provinsi"
  description="Provinsi mana yang harga beras, cabai, bawang, daging, telur, minyak goreng, dan gulanya jauh di atas atau di bawah rata-rata nasional. Data PIHPS Bank Indonesia."
  aktif="peta"
>
  <section class="hero hero--ringkas">
    <p class="kicker">Antarprovinsi · <time datetime={meta.tanggal_acuan}>{tanggalPendek(meta.tanggal_acuan)}</time></p>
    <h1>Peta harga per provinsi</h1>
  </section>

  <section class="bagian bagian--peta" id="peta" data-ctx={JSON.stringify(clientCtx)} data-k={awalK} data-p={awalP.slug}>
    <div class="saring" role="group" aria-label="Pilih komoditas dan jenis pasar">
      <label class="saring__isian saring__isian--lebar">
        <span class="sr-only">Komoditas</span>
        <select id="peta-komoditas">
          {meta.kategori.map((kat) => (
            <optgroup label={kat.nama}>
              <option value={kat.id} selected={kat.id === awalK}>{kat.nama} (rata-rata kelompok)</option>
              {kat.komoditas.map((id) => <option value={id} selected={id === awalK}>{kmap.get(id)?.nama}</option>)}
            </optgroup>
          ))}
        </select>
      </label>
      <label class="saring__isian">
        <span class="sr-only">Jenis pasar</span>
        <select id="peta-pasar">
          {meta.jenis_pasar.map((p) => <option value={p.slug} selected={p.slug === awalP.slug}>{p.nama}</option>)}
        </select>
      </label>
    </div>

    <div class="sorot-peta-baris" id="peta-sorot" aria-live="polite">
      <Fragment set:html={sorotanPeta(rows, sat).value} />
    </div>
    <p class="sr-only" id="peta-ringkas">{ringkasPeta(rows)}</p>

    <div class="peta__tata">
      <figure class="peta__peta">
        <div class="peta-svg" id="peta-svg">
          <svg viewBox={`0 0 ${svg.w} ${svg.h}`} role="img" aria-labelledby="peta-ringkas" preserveAspectRatio="xMidYMid meet">
            <defs>
              <pattern id="arsir" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <rect width="6" height="6" class="arsir__latar" />
                <line x1="0" y1="0" x2="0" y2="6" class="arsir__garis" />
              </pattern>
            </defs>
            <g class="peta-svg__prov">
              {svg.provinsi.map((p) => (
                <path d={p.d} class={`prov k-${kelas.get(p.kode_bps) ?? "na"}`} data-kode={p.kode_bps} data-nama={p.nama} />
              ))}
            </g>
          </svg>
          <div class="peta-penanda" id="peta-penanda">
            {penanda.map((m) =>
              m.p ? (
                <span class={`penanda-peta penanda-peta--${m.id}`} style={`left:${m.p.x.toFixed(2)}%;top:${m.p.y.toFixed(2)}%`} data-sisi={m.p.x > 80 ? "kanan" : m.p.x < 20 ? "kiri" : "tengah"}>
                  <span class="penanda-peta__teks">{m.label}<span class="penanda-peta__nama"> · {m.nama}</span></span>
                </span>
              ) : null,
            )}
          </div>
          <div class="peta-tip" id="peta-tip" hidden></div>
        </div>
        <figcaption>
          <p class="legenda__judul">Dibanding rata-rata nasional</p>
          <div id="peta-legenda"><Fragment set:html={legendaPeta(rows).value} /></div>
          <p class="legenda__na"><span class="legenda__warna k-na" aria-hidden="true"></span>Tanpa data aktif</p>
        </figcaption>
      </figure>
      <div>
        <div class="tabel-wadah peta__tabel" id="peta-tabel">
          <Fragment set:html={tabelPeta(rows, BASE).value} />
        </div>
        <button type="button" class="tombol tombol--garis tabel-buka" id="tabel-buka" hidden>Tampilkan semua provinsi</button>
      </div>
    </div>
    <p class="catatan">Wilayah mengikuti 34 provinsi yang dipakai PIHPS. Ketuk provinsi untuk melihat angkanya.</p>
  </section>

  <script>
    import { persen, rupiah, satuan } from "../lib/format";
    import { KELAS, kelasPerProvinsi, legendaPeta, ringkas, ringkasPeta, sorotanPeta, tabelPeta } from "../lib/peta";
    import type { PetaBaris, PetaDoc } from "../lib/types";

    interface Ctx {
      pasar: string[];
      komoditas: Record<string, { nama: string; satuan: string | null }>;
      pusat: Record<string, [number, number]>;
      dataBase: string;
      base: string;
    }
    const root = document.getElementById("peta")!;
    const ctx = JSON.parse(root.dataset["ctx"]!) as Ctx;
    const params = new URLSearchParams(location.search);
    let k = params.get("k") && ctx.komoditas[params.get("k")!] ? params.get("k")! : root.dataset["k"]!;
    let p = ctx.pasar.includes(params.get("p") ?? "") ? params.get("p")! : root.dataset["p"]!;

    const pilihK = document.getElementById("peta-komoditas") as HTMLSelectElement;
    const pilihP = document.getElementById("peta-pasar") as HTMLSelectElement;
    const wadah = document.getElementById("peta-svg")!;
    const paths = [...wadah.querySelectorAll<SVGPathElement>("path.prov")];
    const grup = wadah.querySelector("g")!;
    const tip = document.getElementById("peta-tip")!;
    const penanda = document.getElementById("peta-penanda")!;
    const tabel = document.getElementById("peta-tabel")!;
    const sorot = document.getElementById("peta-sorot")!;
    const legenda = document.getElementById("peta-legenda")!;
    const ringkasEl = document.getElementById("peta-ringkas")!;

    const cache = new Map<string, Promise<PetaDoc>>();
    const load = (slug: string) => {
      if (!cache.has(slug))
        cache.set(
          slug,
          fetch(`${ctx.dataBase}${slug}.json`).then((r) => {
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            return r.json() as Promise<PetaDoc>;
          }),
        );
      return cache.get(slug)!;
    };

    let byKode = new Map<string, PetaBaris>();
    let sat = "";

    function terapkan(rows: PetaBaris[]) {
      const kelas = kelasPerProvinsi(rows);
      for (const el of paths) el.setAttribute("class", `prov k-${kelas.get(el.dataset["kode"]!) ?? "na"}`);
      byKode = new Map(rows.filter((r) => r.is_aktif && r.kode_bps).map((r) => [r.kode_bps!, r]));
      sat = satuan(ctx.komoditas[k]?.satuan);
      sorot.innerHTML = sorotanPeta(rows, sat).value;
      legenda.innerHTML = legendaPeta(rows).value;
      tabel.innerHTML = tabelPeta(rows, ctx.base).value;
      ringkasEl.textContent = ringkasPeta(rows) || "Belum ada data provinsi untuk pilihan ini.";
      const r = ringkas(rows);
      penanda.innerHTML = "";
      if (r) {
        for (const [id, label, b] of [["mahal", "Termahal", r.termahal], ["murah", "Termurah", r.termurah]] as const) {
          const c = ctx.pusat[b.kode_bps ?? ""];
          if (!c) continue;
          const el = document.createElement("span");
          el.className = `penanda-peta penanda-peta--${id}`;
          el.style.left = `${c[0]}%`;
          el.style.top = `${c[1]}%`;
          el.dataset["sisi"] = c[0] > 80 ? "kanan" : c[0] < 20 ? "kiri" : "tengah";
          const teks = document.createElement("span");
          teks.className = "penanda-peta__teks";
          teks.textContent = label;
          const nama = document.createElement("span");
          nama.className = "penanda-peta__nama";
          nama.textContent = ` · ${b.nama}`;
          teks.append(nama);
          el.append(teks);
          penanda.append(el);
        }
      }
    }

    async function render() {
      pilihK.value = k;
      pilihP.value = p;
      const url = new URL(location.href);
      url.searchParams.set("k", k);
      url.searchParams.set("p", p);
      history.replaceState(null, "", url);
      wadah.classList.add("peta-svg--memuat");
      try {
        const doc = await load(p);
        terapkan(doc.komoditas[k] ?? []);
      } catch {
        sorot.innerHTML = '<p class="kosong">Gagal memuat data. Periksa koneksi lalu coba lagi.</p>';
      } finally {
        wadah.classList.remove("peta-svg--memuat");
      }
    }

    // --- sorotan provinsi: peta <-> tabel, dan tooltip
    let aktif: string | null = null;
    function sorotProv(kode: string | null) {
      if (kode === aktif) return;
      aktif = kode;
      for (const el of paths) el.classList.toggle("prov--aktif", el.dataset["kode"] === kode);
      const el = paths.find((x) => x.dataset["kode"] === kode);
      if (el) grup.append(el); // ke depan supaya garis tepinya tidak tertutup tetangga
      tabel.querySelectorAll("tr[data-kode]").forEach((tr) => tr.classList.toggle("aktif", (tr as HTMLElement).dataset["kode"] === kode));
    }
    function tampilTip(kode: string, x: number, y: number) {
      const r = byKode.get(kode);
      const nama = paths.find((el) => el.dataset["kode"] === kode)?.dataset["nama"] ?? kode;
      tip.innerHTML = "";
      const b = document.createElement("strong");
      b.textContent = r?.nama ?? nama;
      tip.append(b);
      const baris = (t: string) => {
        const s = document.createElement("span");
        s.textContent = t;
        tip.append(s);
      };
      if (r) {
        baris(`${rupiah(r.harga)}${sat}`);
        baris(`${persen(r.selisih_pct_nasional)} vs nasional`);
        baris(`${persen(r.perubahan_pct_7h)} dari minggu lalu`);
      } else baris("Belum ada data aktif");
      tip.hidden = false;
      const box = wadah.getBoundingClientRect();
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      let left = x - box.left + 12;
      if (left + w > box.width) left = x - box.left - w - 12;
      let top = y - box.top - h - 10;
      if (top < 0) top = y - box.top + 14;
      tip.style.left = `${Math.max(0, left)}px`;
      tip.style.top = `${top}px`;
    }
    function sembunyi() {
      tip.hidden = true;
      sorotProv(null);
    }
    function dariPointer(e: MouseEvent) {
      const el = (e.target as Element).closest?.("path.prov") as SVGPathElement | null;
      if (!el) return sembunyi();
      sorotProv(el.dataset["kode"]!);
      tampilTip(el.dataset["kode"]!, e.clientX, e.clientY);
    }
    // mouse: ikuti kursor; sentuh: ketuk provinsi untuk menampilkan angkanya
    wadah.addEventListener("pointermove", (e) => {
      if (e.pointerType === "mouse") dariPointer(e);
    });
    wadah.addEventListener("click", dariPointer);
    wadah.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") sembunyi();
    });
    document.addEventListener("pointerdown", (e) => {
      if (!wadah.contains(e.target as Node)) sembunyi();
    });
    tabel.addEventListener("pointerover", (e) => {
      const tr = (e.target as Element).closest("tr[data-kode]") as HTMLElement | null;
      sorotProv(tr?.dataset["kode"] ?? null);
    });
    tabel.addEventListener("pointerleave", () => sorotProv(null));
    tabel.addEventListener("focusin", (e) => sorotProv(((e.target as Element).closest("tr[data-kode]") as HTMLElement | null)?.dataset["kode"] ?? null));

    // legenda: sorot provinsi satu kelas
    const kelasIds = new Set<string>(KELAS.map((x) => x.id));
    legenda.addEventListener("pointerover", (e) => {
      const li = (e.target as Element).closest("[data-kelas]") as HTMLElement | null;
      const id = li?.dataset["kelas"];
      wadah.dataset["sorotKelas"] = id && kelasIds.has(id) ? id : "";
    });
    legenda.addEventListener("pointerleave", () => (wadah.dataset["sorotKelas"] = ""));

    // Isi awal sudah dirender saat build; render ulang hanya bila URL meminta pilihan lain.
    // Selain itu data tetap dimuat diam-diam untuk tooltip.
    if (k !== root.dataset["k"] || p !== root.dataset["p"]) void render();
    else
      void load(p)
        .then((doc) => {
          const rows = doc.komoditas[k] ?? [];
          byKode = new Map(rows.filter((r) => r.is_aktif && r.kode_bps).map((r) => [r.kode_bps!, r]));
          sat = satuan(ctx.komoditas[k]?.satuan);
        })
        .catch(() => {});

    // HP: ringkas tabel jadi 10 teratas; tombol membuka semuanya
    const buka = document.getElementById("tabel-buka") as HTMLButtonElement;
    const aturRingkas = () => {
      const n = tabel.querySelectorAll("tbody tr").length;
      const ringkas = n > 10 && !buka.dataset["dibuka"];
      tabel.classList.toggle("peta__tabel--ringkas", ringkas);
      buka.hidden = !ringkas;
      buka.textContent = `Tampilkan semua ${n} provinsi`;
    };
    buka.addEventListener("click", () => {
      buka.dataset["dibuka"] = "1";
      aturRingkas();
    });
    aturRingkas();
    new MutationObserver(aturRingkas).observe(tabel, { childList: true });

    pilihK.addEventListener("change", () => {
      k = pilihK.value;
      void render();
    });
    pilihP.addEventListener("change", () => {
      p = pilihP.value;
      void render();
    });
  </script>
</Base>
