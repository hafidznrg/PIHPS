---
import Base from "../../layouts/Base.astro";
import { getMeta } from "../../lib/data";
import { tanggalPendek } from "../../lib/format";
import { wilayahHref } from "../../lib/url";
import type { WilayahMeta } from "../../lib/types";

const meta = getMeta();
const provinsi = meta.wilayah.filter((w) => w.level === "provinsi").sort((a, b) => a.nama.localeCompare(b.nama, "id"));
const kab = (kode: string): WilayahMeta[] =>
  meta.wilayah.filter((w) => w.level === "kabkota" && w.kode_provinsi === kode).sort((a, b) => a.nama.localeCompare(b.nama, "id"));
---

<Base title="Daftar wilayah" description="Semua provinsi dan kabupaten/kota yang harganya dipantau PIHPS Bank Indonesia." aktif="wilayah">
  <section class="hero">
    <p class="kicker">Indeks</p>
    <h1>Daftar wilayah</h1>
    <p class="hero__ket">{provinsi.length} provinsi dan {meta.wilayah.filter((w) => w.level === "kabkota").length} kabupaten/kota yang dipantau PIHPS.</p>
  </section>
  <p class="bagian"><a href={wilayahHref("nasional")}>Nasional (rata-rata Indonesia) →</a></p>
  <div class="daftar-kolom">
    {provinsi.map((p) => (
      <section>
        <h2><a href={wilayahHref(p.kode)}>{p.nama}</a></h2>
        <ul>
          {kab(p.kode).map((k) => (
            <li>
              <a href={wilayahHref(k.kode)}>{k.nama}</a>
              {!k.is_aktif && <span class="catatan"> · data terakhir {tanggalPendek(k.tanggal_terakhir)}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
